[mysqld]
# =====================================================
# EasyAccounts MySQL 配置
# 适用场景：单用户、小数据库（<20MB）
# 目标：实际内存占用约 110MB，开发/测试/单机部署友好，开发期 stale 连接累积也不会撞墙
# v2.7.0 调整说明：原 20MB 模式过于极致，触发 stale 累积撞 max_connections=10 上限的问题；
#                  本次放宽到 30 连接 + 主动清 stale，并让 InnoDB 缓存够把整个 DB 装进内存
# =====================================================

# ── InnoDB 内存（最影响查询速度） ──
innodb_buffer_pool_size=64M           # 20M → 64M：单用户 DB <20MB，64M 把整个数据库+索引缓存进内存，查询不读盘
innodb_log_buffer_size=4M             # 1M → 4M：写多时减少 flush 次数

# ── 连接管理（v2.7.0 修 stale 累积撞墙） ──
max_connections=30                    # 10 → 30：单用户绰绰有余，留余量给开发期 IDE/DBeaver/旧 Hikari 池漂浮的 stale
wait_timeout=600                      # 默认 28800（8h）→ 600（10min）：主动清 10 分钟无活动的连接，避免 stale 一直占名额
interactive_timeout=600               # 同上，给 mysql CLI 客户端用

# ── 表 / 线程缓存 ──
table_definition_cache=100            # 50 → 100：小成本提速
table_open_cache=100                  # 50 → 100
thread_cache_size=8                   # 2 → 8：减少频繁建线程
host_cache_size=0                     # 禁用 DNS cache（外网客户端不需要）

# ── 每线程缓冲（仅活跃连接占用） ──
sort_buffer_size=512K                 # 256K → 512K
read_buffer_size=256K                 # 128K → 256K
read_rnd_buffer_size=512K             # 256K → 512K
join_buffer_size=512K                 # 256K → 512K

# ── 关闭性能监控（节省 ~80MB） ──
performance_schema=OFF

# ── 保持默认（不显式设置） ──
# innodb_flush_log_at_trx_commit=1（默认）：每次提交 fsync 到盘，零丢失，安全优先
# max_allowed_packet=64M（默认）：避免限制太严导致大 SQL 备份导入失败
