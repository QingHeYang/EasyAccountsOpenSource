# =====================================================
# EasyAccounts Server - 本地开发配置模板
# =====================================================
# 使用方法：
# 1. 复制此文件为 application-local.properties
# 2. 修改下方配置为你本地的实际值
# 3. application-local.properties 不会提交到 git
# =====================================================

# =====================================================
# 数据库配置
# =====================================================
spring.datasource.url=jdbc:mysql://localhost:3306/yd_jz?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=你的数据库密码
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver

# v2.7.0: Hikari 连接池调优 —— 防止 stale 连接累积撞 MySQL max_connections 上限
spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.max-lifetime=600000
spring.datasource.hikari.keepalive-time=300000
spring.datasource.hikari.connection-timeout=5000

# MyBatis 驼峰命名转换
mybatis.configuration.map-underscore-to-camel-case=true

# =====================================================
# 服务配置
# =====================================================
server.port=8085

# 循环依赖（临时方案，后续修复）
spring.main.allow-circular-references=true

# Tomcat 线程优化（单用户场景，节省内存）
server.tomcat.threads.max=10
server.tomcat.threads.min-spare=1

# =====================================================
# 文件路径配置（必须使用绝对路径）
# =====================================================
# Excel 模板路径（指向 YD_JZ/excel_template 目录）
baseAutoExcel=D:/你的项目路径/Server/YD_JZ/excel_template/auto_excel.xlsx
baseScreenExcel=D:/你的项目路径/Server/YD_JZ/excel_template/screen_excel.xlsx

# Excel 输出路径（自行创建目录）
excelAutoFolder=D:/你的输出路径/excel/month/
excelScreenFolder=D:/你的输出路径/excel/screen/
excelAnalysisFolder=D:/你的输出路径/excel/analysis/

# 图片上传路径
image.upload.path=D:/你的输出路径/images/

# 认证文件路径
auth.folder=D:/你的输出路径/auth/

# =====================================================
# SQL 备份配置
# =====================================================
# 备份文件路径
sqlBackUpFolder=D:/你的输出路径/backup/

# 操作系统类型：win / ubuntu（本地开发用 win，Docker 环境用 ubuntu）
system.os=win

# 备份命令（Windows 需配置 mysqldump 完整路径）
sqldumpCmd=D:/你的mysql路径/bin/mysqldump -h localhost -P 3306 -uroot -p你的数据库密码 --databases yd_jz >

# 恢复命令（Windows 需配置 mysql 完整路径）
sqlRestoreCmd=D:/你的mysql路径/bin/mysql -h localhost -P 3306 -uroot -p你的数据库密码 yd_jz <

# 恢复前清空数据库命令（先删库再建库，确保兼容旧版本备份）
sqlDropCreateCmd=D:/你的mysql路径/bin/mysql -h localhost -P 3306 -uroot -p你的数据库密码 -e "DROP DATABASE IF EXISTS yd_jz; CREATE DATABASE yd_jz;"

# 备份定时任务 cron 表达式（默认晚上 22 点）
# v2.7.0 (config-ui): cron.sqlBackupTime 已下沉到 app_config.backup.*

# =====================================================
# 认证配置
# =====================================================
# 是否启用登录认证
# v2.7.0 (config-ui): auth.enable 已下沉到 app_config.auth.login_enable

# Token 过期时间（分钟）
# v2.7.0 (config-ui): auth.expired 已下沉到 app_config.auth.token_expired_minutes

# 单设备登录模式：true=新登录踢掉旧设备，false=多设备共享Token
# v2.7.0 (config-ui): auth.single_login 已下沉到 app_config.auth.single_login

# =====================================================
# 外部服务
# =====================================================
# v2.7.0 (config-ui)：WebHook 容器已退场，邮件发送内聚到 Server，
# SMTP 配置走 app_config.mail.*，请在前端"系统设置-邮件"中填写

# =====================================================
# AI 服务配置（可选）
# =====================================================
# 阿里通义千问 API Key（用于 AI 识别账单功能）
# 获取地址：https://dashscope.console.aliyun.com/
# 不填则 AI 功能不可用，不影响其他功能
qwen.client.api-key=

# =====================================================
# 日志配置
# =====================================================
logging.config=classpath:log4j2.xml

# =====================================================
# 文件上传配置
# =====================================================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
spring.servlet.multipart.resolve-lazily=true

# =====================================================
# Tomcat 配置
# =====================================================
server.tomcat.connection-timeout=60000
server.tomcat.max-swallow-size=10MB
server.tomcat.max-http-form-post-size=10MB

# =====================================================
# Liquibase 数据库迁移
# =====================================================
spring.liquibase.change-log=classpath:/db/changelog/db.changelog-master.yaml

# =====================================================
# 版本信息
# =====================================================
version.release=2.7.0-local
version.code=2700
version.font_branch=4.1.0-local
version.backend_branch=2.7.0-local
version.mysql_branch=2.7.0-local
version.agent_branch=1.2.0-local
# v2.7.0 (config-ui): version.webhook_branch 移除 —— WebHook 容器退场

# 云端版本通知 JSON 地址（用于检查更新）
version.notice.url=https://blue-out-share.oss-cn-zhangjiakou.aliyuncs.com/version-notice.json

# 公告通知 JSON 地址（用户主动获取）
notices.url=https://blue-out-share.oss-cn-zhangjiakou.aliyuncs.com/notices.json
