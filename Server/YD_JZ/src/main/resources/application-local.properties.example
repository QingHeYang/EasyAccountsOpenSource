# =====================================================
# 本地开发配置模板
# =====================================================
# 使用方法：
# 1. 复制此文件为 application-local.properties
# 2. 修改下方配置为你本地的实际值
# 3. application-local.properties 不会提交到 git
# =====================================================

# 数据库配置
spring.datasource.url=jdbc:mysql://localhost:3306/yd_jz?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=你的数据库密码
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver

# MyBatis
mybatis.configuration.map-underscore-to-camel-case=true

# 服务端口
server.port=8085

# =====================================================
# 文件路径配置（修改为你本地的路径）
# =====================================================
# Excel 模板路径
baseAutoExcel=D:/EasyAccounts/excel_template/auto_excel.xlsx
baseScreenExcel=D:/EasyAccounts/excel_template/screen_excel.xlsx
# baseAnalysisExcel 已移除

# Excel 输出路径
excelAutoFolder=D:/EasyAccounts/excel/month/
excelScreenFolder=D:/EasyAccounts/excel/screen/
excelAnalysisFolder=D:/EasyAccounts/excel/analysis/

# SQL 备份路径
sqlBackUpFolder=D:/EasyAccounts/backup/

# 图片上传路径
image.upload.path=D:/EasyAccounts/images/

# 认证文件路径
auth.folder=D:/EasyAccounts/auth/

# =====================================================
# 其他配置
# =====================================================
# WebHook URL（本地开发可留空或指向本地服务）
webhook_url=http://localhost:8083/webhook

# 认证配置
auth.enable=false
auth.expired=999
auth.single_login=true

# 日志配置
logging.config=classpath:log4j2.xml

# 文件上传限制
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Liquibase
spring.liquibase.change-log=classpath:/db/changelog/db.changelog-master.yaml

# 循环依赖（临时）
spring.main.allow-circular-references=true

# 版本信息（本地开发用）
version.release=2.6.0-local
version.font_branch=dev
version.backend_branch=dev
version.mysql_branch=dev
version.agent_branch=dev
version.webhook_branch=dev
