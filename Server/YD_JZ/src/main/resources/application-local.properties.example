# =====================================================
# EasyAccounts Server - 本地开发配置模板
# =====================================================
# 使用方法：
# 1. 复制此文件为 application-local.properties
# 2. 修改下方配置为你本地的实际值
# 3. application-local.properties 不会提交到 git
# =====================================================

# =====================================================
# 数据库配置
# =====================================================
spring.datasource.url=jdbc:mysql://localhost:3306/yd_jz?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=你的数据库密码
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver

# MyBatis 驼峰命名转换
mybatis.configuration.map-underscore-to-camel-case=true

# =====================================================
# 服务配置
# =====================================================
server.port=8085

# 循环依赖（临时方案，后续修复）
spring.main.allow-circular-references=true

# =====================================================
# 文件路径配置（必须使用绝对路径）
# =====================================================
# Excel 模板路径（指向 YD_JZ/excel_template 目录）
baseAutoExcel=D:/你的项目路径/Server/YD_JZ/excel_template/auto_excel.xlsx
baseScreenExcel=D:/你的项目路径/Server/YD_JZ/excel_template/screen_excel.xlsx

# Excel 输出路径（自行创建目录）
excelAutoFolder=D:/你的输出路径/excel/month/
excelScreenFolder=D:/你的输出路径/excel/screen/
excelAnalysisFolder=D:/你的输出路径/excel/analysis/

# 图片上传路径
image.upload.path=D:/你的输出路径/images/

# 认证文件路径
auth.folder=D:/你的输出路径/auth/

# =====================================================
# SQL 备份配置
# =====================================================
# 备份文件路径
sqlBackUpFolder=D:/你的输出路径/backup/

# 备份命令（Windows 需配置 mysqldump 路径）
sqldumpCmd=mysqldump -h localhost -P 3306 -uroot -p你的数据库密码 --databases yd_jz >

# 备份定时任务 cron 表达式（默认晚上 22 点）
cron.sqlBackupTime=0 0 22 * * ?

# =====================================================
# 认证配置
# =====================================================
# 是否启用登录认证
auth.enable=false

# Token 过期时间（分钟）
auth.expired=30

# 单设备登录模式：true=新登录踢掉旧设备，false=多设备共享Token
auth.single_login=true

# =====================================================
# 外部服务
# =====================================================
# WebHook 服务地址
webhook_url=http://localhost:8083/webhook

# =====================================================
# AI 服务配置（可选）
# =====================================================
# 阿里通义千问 API Key（用于 AI 识别账单功能）
# 获取地址：https://dashscope.console.aliyun.com/
# 不填则 AI 功能不可用，不影响其他功能
qwen.client.api-key=

# =====================================================
# 日志配置
# =====================================================
logging.config=classpath:log4j2.xml

# =====================================================
# 文件上传配置
# =====================================================
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
spring.servlet.multipart.resolve-lazily=true

# =====================================================
# Tomcat 配置
# =====================================================
server.tomcat.connection-timeout=60000
server.tomcat.max-swallow-size=10MB
server.tomcat.max-http-form-post-size=10MB

# =====================================================
# Liquibase 数据库迁移
# =====================================================
spring.liquibase.change-log=classpath:/db/changelog/db.changelog-master.yaml

# =====================================================
# 版本信息
# =====================================================
version.release=2.6.0-local
version.code=260
version.font_branch=4.0.0-local
version.backend_branch=2.5.1-local
version.mysql_branch=2.5.0-local
version.agent_branch=1.1.0-local
version.webhook_branch=1.0.0-local

# 云端版本通知 JSON 地址（用于检查更新）
version.notice.url=https://blue-out-share.oss-cn-zhangjiakou.aliyuncs.com/version-notice.json
