# KoalaQ Hub 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置

# ===== API 服务配置 =====
# API服务端口
API_PORT=8001
# API服务主机
API_HOST=0.0.0.0

# ===== LLM 配置 =====
# LLM 请求超时时间（秒）
LLM_TIMEOUT=120.0
# EasyAccounts Agent 的 LLM 配置（环境变量优先于 llm_config.ini）
LLM_EASY_ACCOUNTS_API_KEY=
LLM_EASY_ACCOUNTS_URL=
LLM_EASY_ACCOUNTS_MODEL=

# ===== 总结配置 =====
# 单轮总结最大长度
ROUND_SUMMARY_MAX_LENGTH=200
# 多少轮对话后进行快照总结
ROUND_SUMMARY_TIMES=5
# 快照总结最大长度
SNAPSHOT_SUMMARY_MAX_LENGTH=500
# 多少个快照后进行对话总结
CONVERSATION_SUMMARY_SNAPSHOTS=3
# 对话总结最大长度
CONVERSATION_SUMMARY_MAX_LENGTH=800

# ===== Agent缓存配置 =====
# Agent断开连接后的缓存保留时间（分钟）
# 默认30分钟，在此时间内重连会复用原有Agent对象
AGENT_CACHE_TIMEOUT_MINUTES=30

# ===== 数据库配置 =====
# 数据库存储目录路径（相对于项目根目录或绝对路径）
DATABASE_DIR=./resource/database
DATABASE_NAME=koalaq.db

# ===== 资源路径配置 =====
PROMPT_DIR=./resource/prompts
ROLE_DIR=./resource/role
USER_INIT_DIR=./resource/user
AGENT_GUIDE_DIR=./resource/agents

# ===== 配置文件路径 =====
LLM_CONFIG=./resource/config/llm_config.ini
AGENT=./resource/config/agent.ini

# ===== EasyAccounts 配置 =====
# EasyAccounts 后端服务地址
EASYACCOUNTS_URL=http://localhost:8081

# ===== MCP 服务器配置 =====
# 是否启用MCP服务器 (true/false)
MCP_SERVER_ENABLED=false
# MCP传输模式: sse 或 streamable-http
# - sse: Server-Sent Events，兼容性好，适合大多数客户端（如Cherry Studio）
# - streamable-http: Streamable HTTP，更高效，适合支持该协议的客户端
MCP_TRANSPORT_MODE=streamable-http
# MCP连接地址:
# - SSE模式: http://{host}:{API_PORT}/sse?token=<your_token>
# - HTTP模式: http://{host}:{API_PORT}/mcp?token=<your_token>
