# 开发环境配置模板
# 使用方法：复制此文件为 .env.development，然后修改为你的本地配置
# cp .env.development.example .env.development

# 后端 API 服务地址
# 本地开发：http://localhost:8081
# 远程服务：http://your-server:port
VITE_SERVER_TARGET=http://localhost:8081

# AI 服务地址
# 本地开发：http://localhost:8001
# 远程服务：http://your-ai-server:port
VITE_AI_TARGET=http://localhost:8001
